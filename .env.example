# Salin file ini menjadi .env sebelum menjalankan apa pun:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Mac / Linux)
#
# Isi sesuai PostgreSQL di komputer Anda. Bentuknya:
#     postgres://PENGGUNA:PASSWORD@ALAMAT:PORT/NAMA_DATABASE
#
# 5432 adalah port bawaan PostgreSQL. Ganti kalau punya Anda berbeda.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/media_monitoring

# OPSIONAL. Kalau diisi, `npm test` memakai database ini, bukan yang di atas.
# Gunanya: tes integrasi mengosongkan tabel sebelum bekerja, jadi kalau Anda
# sudah memasukkan data dan tidak ingin hilang, arahkan tes ke database lain.
#   createdb media_monitoring_test
#   npm run db:setup   (dengan DATABASE_URL diarahkan ke database tes)
# Kalau dibiarkan kosong, tes memakai DATABASE_URL di atas dan tabelnya akan
# kosong setelah tes selesai. Jalankan `npm run ingest` lagi untuk mengisinya.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/media_monitoring_test

# Port tempat API ini berjalan. Ganti kalau 3000 sudah dipakai program lain.
PORT=3000

# Alamat yang didengarkan. 127.0.0.1 berarti hanya bisa diakses dari komputer
# ini sendiri -- pilihan yang aman untuk pengembangan lokal.
# Kalau di-deploy ke layanan hosting, isi 0.0.0.0
HOST=127.0.0.1
