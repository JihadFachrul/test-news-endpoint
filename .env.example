# Salin file ini menjadi .env sebelum menjalankan apa pun:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Mac / Linux)
#
# Isi sesuai PostgreSQL di komputer Anda. Bentuknya:
#     postgres://PENGGUNA:PASSWORD@ALAMAT:PORT/NAMA_DATABASE
#
# 5432 adalah port bawaan PostgreSQL. Ganti kalau punya Anda berbeda.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/media_monitoring

# Port tempat API ini berjalan.
PORT=3000
