{
  "name": "media-monitoring-slice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "db:setup": "tsx scripts/setup-db.ts",
    "ingest": "tsx scripts/ingest-seed.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
